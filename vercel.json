{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/pdf-parse/dist/pdf-parse/cjs/pdf.worker.mjs"
    }
  },
  "routes": [
    {
      "src": "^/api(?:/(.*))?$",
      "dest": "/api/index.js"
    }
  ]
}
